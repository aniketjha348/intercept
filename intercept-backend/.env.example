# Copy to .env
# LLM providers (optional — rules engine carries detection without keys)
# Gemini: FREE-tier key from Google AI Studio (aistudio.google.com) → GOOGLE_API_KEY
# OpenAI: paid key → OPENAI_API_KEY. auto tries Gemini first, then OpenAI.
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=auto   # auto | gemini | openai | off
LLM_MODEL=          # default: gemini-2.5-flash-lite (verified working; 2.0-flash retired)

# Languages: hi | hinglish | en (auto-detected per input unless pinned)
DEFAULT_LANGUAGE=auto

# Defensive URL fetch (off by default; never submits credentials)
ALLOW_NETWORK_FETCH=false

# DB (MVP runs in-memory; point at Postgres when ready)
DATABASE_URL=sqlite:///./intercept.db

# Distribution feed (/app/latest): GitHub Release APK URL (empty = local dev)
APK_URL=
