# Copy to .env
# LLM providers (optional — rules engine carries detection without keys)
# Gemini: FREE-tier key from Google AI Studio (aistudio.google.com) → GOOGLE_API_KEY
# OpenAI: paid key → OPENAI_API_KEY. auto tries Gemini first, then OpenAI.
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=auto   # auto | gemini | openai | off
LLM_MODEL=          # default: gemini-3.5-flash-lite (probed working; 2.5 dies Oct 2026)

# Languages: hi | hinglish | en (auto-detected per input unless pinned)
DEFAULT_LANGUAGE=auto

# Defensive URL fetch (off by default; never submits credentials)
ALLOW_NETWORK_FETCH=false

# DB (MVP runs in-memory; point at Postgres when ready)
DATABASE_URL=sqlite:///./intercept.db

# Distribution feed (/app/latest): GitHub Release APK URL (empty = local dev)
APK_URL=

# Guardian voice: Gemini TTS (empty = code defaults + auto model fallback).
# Voices: 30 prebuilt names (Sulafat=warm, Kore=neutral…) — hear them in AI Studio.
# NOTE: Gemini 2.5 shuts down Oct 2026 → then pin TTS_MODEL to a 3.x TTS model.
TTS_MODEL=
TTS_VOICE_HI=
TTS_VOICE_EN=

# Realtime voice bridge (/ws/live): Live model + endpoint override (tests).
# Probed working: gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-preview-12-2025.
LIVE_MODEL=
GEMINI_LIVE_URL=

# LiveKit (voice agent + SIP calls). Must be the SAME project as
# livekit-agent/.env.local or the agent cannot join the rooms the backend
# mints. Empty = /livekit/* returns 503 and SIP calls have no bridge.
LIVEKIT_URL=
LIVEKIT_KEY=
LIVEKIT_SECRET=

# WhatsApp bot number (forward-to-verify). Empty = endpoints report OFF.
# Needs Meta app + token + HTTPS webhook (see app/api/whatsapp.py header).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY=intercept-verify
